# PREPARED, NOT PUBLISHED. Shape: lope bc388673 packaging/PKGBUILD.
# v0.2.0 does not exist yet. Release lane supplies its archive digest.
pkgname=scent
pkgver=0.2.0
pkgrel=1
pkgdesc='Recursive C-locale grep in wolf, with terminal colour'
arch=('x86_64')
url='https://github.com/wolffe-lang/scent'
license=('GPL-3.0-or-later')
depends=('glibc' 'sh')
makedepends=('clang')
_wolf=0.2.36
_std=78b9d3cbc41d51db44d18c40b6694403644d1c83
source=("$pkgname-$pkgver.tar.gz::https://github.com/wolffe-lang/scent/archive/refs/tags/v$pkgver.tar.gz"
        "wolf-$_wolf-x86_64-unknown-linux-gnu.tar.gz::https://github.com/wolffe-lang/wolf-lang/releases/download/v$_wolf/wolf-$_wolf-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('RELEASE-LANE-FILLS-THIS'
            'd383c74c8cd123b9d9dfaa268271d4f004294f85c2b230237d0ef07027d9500d')
build() {
    cd "$pkgname-$pkgver"
    local tc="$srcdir/wolf-$_wolf-x86_64-unknown-linux-gnu"
    test "$(cat "$tc/std/STD-REV")" = "$_std"
    WOLF_STD="$tc/std" "$tc/wolf" build --release --deny-warnings src/scent.lu -o scent
}
check() {
    export LC_ALL=C
    cd "$pkgname-$pkgver"
    ./scent --version
    test "$(printf 'ab\nno\n' | ./scent -E '^a[ab]$')" = ab
    test "$(printf 'aa\nno\n' | ./scent -G '\(a\)\1')" = aa
    test "$(printf 'a.b\naxb\n' | ./scent -F 'a.b')" = a.b
    mkdir -p .package-tree
    printf 'hit\n' > .package-tree/a.txt
    printf 'miss\n' > .package-tree/b.dat
    test "$(./scent -rh --include='*.txt' hit .package-tree)" = hit
    test "$(printf 'hit\n' | ./scent --color=always hit | od -An -tx1 | tr -d ' \n')" = 1b5b30313b33316d1b5b4b6869741b5b6d1b5b4b0a
}
package() {
    cd "$pkgname-$pkgver"
    install -Dm755 scent "$pkgdir/usr/bin/scent"
    # Do not replace the distribution's grep. Optional compatibility PATH.
    install -d "$pkgdir/usr/lib/scent/bin"
    ln -s ../../../bin/scent "$pkgdir/usr/lib/scent/bin/grep"
    install -m755 wrappers/egrep wrappers/fgrep "$pkgdir/usr/lib/scent/bin/"
    install -Dm644 README.md "$pkgdir/usr/share/doc/scent/README.md"
    for f in LICENSE LICENSE-TRAINING-DATA; do
        install -Dm644 "$f" "$pkgdir/usr/share/licenses/scent/$f"
    done
}
