#!/usr/bin/env python3
"""Use scent-oracle.toml and ct00's fixed-path, signature-checked build."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import subprocess
import tomllib
ROOT=Path(__file__).resolve().parent.parent
PIN=tomllib.loads((ROOT/'scent-oracle.toml').read_text())['oracle']

def digest(path):
    with open(path,'rb') as f:return hashlib.file_digest(f,'sha256').hexdigest()

def validate(binary,identity):
    binary=str(Path(binary).resolve())
    data=json.loads(Path(identity).read_text())
    if any(data.get(k)!=v for k,v in PIN.items()):raise RuntimeError('STOP: oracle manifest differs from shared pin')
    if digest(binary)!=PIN['binary_sha256']:raise RuntimeError('STOP: oracle executable digest drift')
    if subprocess.check_output(['ldd','--version']).splitlines()[0].decode()!=PIN['glibc_line']:raise RuntimeError('STOP: wrong oracle glibc')
    if subprocess.check_output([binary,'--version']).splitlines()[0].decode()!=PIN['version_line']:raise RuntimeError('STOP: wrong oracle version')
    r=subprocess.run(['grep','-P','x'],executable=binary,input=b'',capture_output=True,env={**os.environ,'LC_ALL':'C'})
    if r.returncode!=PIN['perl_status'] or r.stdout or r.stderr!=(PIN['perl_refusal']+'\n').encode():raise RuntimeError('STOP: wrong oracle PCRE configuration')
    return data

def main():
    p=argparse.ArgumentParser();p.add_argument('binary');p.add_argument('identity');a=p.parse_args()
    print(json.dumps(validate(a.binary,a.identity),sort_keys=True))
if __name__=='__main__':main()
