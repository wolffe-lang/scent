#!/usr/bin/env python3
"""R-ct01-3: systematic repeated-assertion selection/span witnesses."""
import json
from pathlib import Path
import runpy
import sys
root=Path(__file__).resolve().parent
run=runpy.run_path(str(root/'re-probe'))['run']
assertions=[b'^',b'$',br'\b',br'\B',br'\<',br'\>',br'\`',br"\'"]
quantifiers=[b'*',b'+',b'?',b'{0}',b'{1}',b'{2}',b'{0,2}',b'{1,}',b'{,2}',b'**',b'+?']
lines=[b'',b'a',b'aa',b'ab',b' a ',b'a*',b'*a',b'a+',b'+a',b'a?',b'?a',b'a{2}',b'{2}a',b'a2}',b'2}a',b'a0}',b'0}a',b'a1}',b'1}a',b'a,2}',b',2}a',b'a{1,}',b'1,}a',b'a-bx',b'---',b' '] 
for syntax in ('basic','extended'):
 for assertion in assertions:
  for quant in quantifiers:
   q=quant if syntax=='extended' else bytes().join(b'\\'+bytes([c]) if c in b'+?{}' else bytes([c]) for c in quant)
   for prefix,suffix in ((b'',b''),(b'a',b''),(b'',b'a'),(b'a',b'b')):
    p=prefix+assertion+q+suffix
    row=dict(syntax=syntax,assertion=assertion.hex(),quantifier=quant.hex(),prefix=prefix.hex(),suffix=suffix.hex(),pattern=p.hex(),lines=[x.hex() for x in lines])
    row['select']=run(str(root.parent/'.oracle/grep'),[p],lines,syntax,spans=False)
    row['span']=run(str(root.parent/'.oracle/grep'),[p],lines,syntax,spans=True)
    print(json.dumps(row),flush=True)
