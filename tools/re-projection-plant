#!/usr/bin/env python3
"""Prove the filter-off soak rejects a false-negative projection."""
import argparse
import json
from pathlib import Path
import subprocess
ROOT=Path(__file__).resolve().parent.parent

def main():
    p=argparse.ArgumentParser();p.add_argument('--work',type=Path,required=True);a=p.parse_args();a.work.mkdir(parents=True,exist_ok=True)
    source=ROOT/'src/re/linear.lu';original=source.read_text()
    def build(label):
        r=subprocess.run([str(ROOT/'tools/re-driver')],capture_output=True,timeout=120)
        (a.work/(label+'-build.log')).write_bytes(r.stdout+r.stderr)
        if r.returncode:raise RuntimeError('projection plant build failed')
    def soak(label):
        r=subprocess.run(['python3','-I',str(ROOT/'tools/re-projection-soak'),'--soak','1000','--work',str(a.work/label)],capture_output=True,timeout=120)
        (a.work/(label+'.log')).write_bytes(r.stdout+r.stderr)
        return r.returncode
    try:
        guard='if projected && inst.op == REF {'
        assert original.count(guard)==1
        # Remove the epsilon exit: a projected reference can consume but
        # never finish. Real accepting backreference paths are falsely lost.
        source.write_text(original.replace(guard,'if !projected && inst.op == REF {'))
        build('red')
        if soak('red')==0:raise RuntimeError('false-negative filter survived the counterfactual gate')
        failures=json.loads((a.work/'red/projection.json').read_text())['failures']
        if not any(any(want and not got for got,want in zip(r['filtered']['selected'],r['unfiltered']['selected'])) for r in failures):
            raise RuntimeError('soak did not record an actual false-negative selection')
        print('RED projection plant: removing REF epsilon exit loses real matches; filter-off soak rejected it',flush=True)
        source.write_text(original)
        build('green')
        if soak('green')!=0:raise RuntimeError('restored projection soak is red')
        print('GREEN projection soak after restoring the regular superset',flush=True)
    finally:
        source.write_text(original)
        build('restored')
    print('PASS projection plant; source and driver restored',flush=True)
if __name__=='__main__':main()
