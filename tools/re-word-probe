#!/usr/bin/env python3
"""R-ct01-3: one bounded word-stepping/backreference-dispatch matrix."""
import json
from pathlib import Path
import runpy
HERE = Path(__file__).resolve().parent
run = runpy.run_path(str(HERE/'re-probe'))['run']
bre = runpy.run_path(str(HERE/'re-oracle'))['bre']
patterns=[b'.',b'.{1,2}',b'.{1,3}',b'[[:space:]]{2}|.',br'\S{,2}',br'\s+?',b'a|a-b',b'(a|a-b)',b'(a|a-b){1}',b'[a]|a-b',b'a|a-b[x]{0}']
lines=[b'',b'a-bx',b'a-bx a-bx',b'  ab',b'    ab',b'      ab',b'---a',b'---ab',b'a---b',b' A1\r b\x80aa0',b'\t\r \tBB0b',b'\x80\t\t\r0B']
lines += [b'x '*n+suffix for n in range(5) for suffix in (b'    ab',b'a-bx',b'---ab')]
for syntax in ('basic','extended'):
    for p in patterns:
        for flags in (['-w'],['-w','-i']):
            pattern=p if syntax=='extended' else bre(p)
            row=dict(family='word',syntax=syntax,pattern=pattern.hex(),flags=flags,lines=[s.hex() for s in lines])
            row['select']=run('/lane/oracle/bin/grep',[pattern],lines,syntax,flags,spans=False)
            row['span']=run('/lane/oracle/bin/grep',[pattern],lines,syntax,flags)
            print(json.dumps(row),flush=True)
    for p in (br'\b*',br'\<{1,}',br'\`*',br"\'*",br'a\>{2}',br'(a)\1*',br'(a)\1**'):
        for wrap in (b'%s',b'(%s)',b'(%s|())',b'%s(a)\\1',b'(%s|z(z)\\2)'):
            pattern=wrap%p
            if syntax=='basic':pattern=bre(pattern)
            subject=lines+[b'a',b'aa',b'aaa',b'z',b'zz']
            row=dict(family='dispatch',syntax=syntax,pattern=pattern.hex(),flags=[],lines=[s.hex() for s in subject])
            row['select']=run('/lane/oracle/bin/grep',[pattern],subject,syntax,spans=False)
            row['span']=run('/lane/oracle/bin/grep',[pattern],subject,syntax)
            print(json.dumps(row),flush=True)
