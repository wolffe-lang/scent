#!/bin/sh
# Lane-owned container; aspen 476edee3 tools/in-container shape.
set -eu
SCENT_ROOT=$(cd "$(dirname "$0")/.." && pwd)
engine=${SCENT_ENGINE:-podman}
image=${SCENT_IMAGE:-localhost/scent-oracle}
"$engine" image inspect "$image" >/dev/null 2>&1 || "$engine" build --build-arg "BUILD_CPUS=${SCENT_CPUS:-0}" -t "$image" -f "$SCENT_ROOT/ci/oracle.Containerfile" "$SCENT_ROOT/ci"
# target/ is made here, by the calling user, before the engine runs. An engine running as root
# would otherwise make it root-owned on the first write under it (a toolchain fetch with no cache
# makes target/tmp), and a later step on the host could not write under target/.
mkdir -p "$SCENT_ROOT/target"
exec "$engine" run --rm ${SCENT_CONTAINER_ARGS:-} -e SCENT_IN_CONTAINER=1 -e GITHUB_SHA -e GITHUB_ACTIONS -e CARGO_INCREMENTAL=0 -e LC_ALL=C -v "$SCENT_ROOT:/work/scent:Z" -w /work/scent "$image" "$@"
