#!/bin/sh
# Secondary reference: wolffe-lang/lope bc388673 tools/mkstatic.
# Adapted from wolffe-lang/aspen 476edee3 tools/mkaspen; own code.
# mkscent — scent as a fully static x86-64 Linux executable, the shape PAX
# runs (pax's tools/mkpelt, lope's tools/mkstatic): the release tier, linked
# through a `cc` that adds `-static` (tools/build --static), checked to be
# ET_EXEC with no PT_INTERP, BUILT TWICE and refused unless both digests
# agree, and written to OUTDIR/sums.txt as `scent <sha256> <bytes>`, with
# the stripped size beside it.
#
#   tools/mkscent OUTDIR
#
# Build on a baseline x86-64 glibc (the CI runner's Ubuntu; an Ubuntu
# container on kasumi), never on kasumi's CachyOS x86-64-v4 glibc (px10).
set -eu
SCENT_ROOT=$(cd "$(dirname "$0")/.." && pwd)
out=${1:?usage: mkscent OUTDIR}
cd "$SCENT_ROOT"
mkdir -p "$out"
digest() { sha256sum "$1" | cut -d' ' -f1; }
tools/build --static
cp target/static/scent "$out/scent.first"
tools/build --static
bin="$out/scent"
cp target/static/scent "$bin"
a=$(digest "$out/scent.first")
b=$(digest "$bin")
rm -f "$out/scent.first"
if [ "$a" != "$b" ]; then
    echo "mkscent: REFUSED — two builds differ: $a, then $b" >&2
    exit 1
fi
readelf -hW "$bin" | grep -Eq 'Type: +EXEC' || { echo "mkscent: $bin is not ET_EXEC" >&2; exit 1; }
if readelf -lW "$bin" | grep -q INTERP; then
    echo "mkscent: $bin has a PT_INTERP (not static)" >&2
    exit 1
fi
"$bin" --version
bytes=$(wc -c <"$bin" | tr -d ' ')
strip -o "$out/scent.stripped" "$bin"
sbytes=$(wc -c <"$out/scent.stripped" | tr -d ' ')
printf 'scent %s %s\n' "$b" "$bytes" | tee "$out/sums.txt"
printf 'scent (built twice, the same digest); stripped: %s bytes, sha256 %s\n' "$sbytes" "$(digest "$out/scent.stripped")"
printf 'linked against: %s\n' "$(cc -print-file-name=libc.a)"
