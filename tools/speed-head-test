#!/usr/bin/env python3
"""Run the real recorder CLI outside a repository and with unavailable Git metadata."""
import json,os,pathlib,shutil,subprocess,tempfile
ROOT=pathlib.Path(__file__).resolve().parent.parent
base_env={k:v for k,v in os.environ.items() if not k.startswith('GIT_') and k!='GITHUB_SHA'}
with tempfile.TemporaryDirectory(prefix='speed-head-',dir=ROOT/'target') as directory:
 tmp=pathlib.Path(directory);repo=tmp/'checkout';outside=tmp/'outside';repo.mkdir();outside.mkdir();(repo/'tools').mkdir()
 # Do not let the sibling caller discover the real checkout above target/.
 base_env['GIT_CEILING_DIRECTORIES']=str(tmp)
 assert subprocess.run(['git','rev-parse','--show-toplevel'],cwd=outside,env=base_env,capture_output=True).returncode!=0
 shutil.copy2(ROOT/'tools/speed',repo/'tools/speed')
 env=dict(base_env,GIT_AUTHOR_NAME='Recorder Test',GIT_AUTHOR_EMAIL='test@example.invalid',GIT_COMMITTER_NAME='Recorder Test',GIT_COMMITTER_EMAIL='test@example.invalid')
 subprocess.run(['git','init',str(repo)],env=env,check=True,capture_output=True)
 subprocess.run(['git','-c','commit.gpgsign=false','-C',str(repo),'commit','--allow-empty','-m','Create recorder fixture'],env=env,check=True,capture_output=True)
 head=subprocess.check_output(['git','-C',str(repo),'rev-parse','HEAD'],env=env,text=True).strip()
 def run(extra=None):
  return subprocess.run(['python3','-I',str(repo/'tools/speed'),'--record-head'],cwd=outside,env=dict(base_env,**(extra or {})),capture_output=True,text=True)
 def succeeds(name,extra,sha,source):
  p=run(extra);assert p.returncode==0,(name,p.stdout,p.stderr)
  assert json.loads(p.stdout)=={'head':sha,'head_source':source},(name,p.stdout)
  print('PASS',name,flush=True)
 def refuses(name,extra,text):
  p=run(extra);assert p.returncode!=0 and not p.stdout and text in p.stderr,(name,p.stdout,p.stderr)
  print('PASS',name,flush=True)
 succeeds('recorder-non-repo-cwd',{},head,'git')
 succeeds('recorder-ignores-foreign-git-dir',{'GIT_DIR':str(tmp/'not-the-checkout')},head,'git')
 ci_head='a'*40
 succeeds('recorder-github-sha',{'GITHUB_SHA':ci_head},ci_head,'GITHUB_SHA')
 refuses('recorder-invalid-github-sha',{'GITHUB_SHA':'not-a-full-sha'},'speed: REFUSED: invalid GITHUB_SHA')
 # A linked checkout whose common metadata was not mounted into the container.
 (repo/'.git').rename(tmp/'unmounted-metadata')
 (repo/'.git').write_text('gitdir: '+str(tmp/'missing-metadata')+'\n')
 succeeds('recorder-github-sha-without-git',{'GITHUB_SHA':ci_head},ci_head,'GITHUB_SHA')
 refuses('recorder-no-head-refuses',{},'speed: REFUSED: cannot record checkout head')
 assert '-e GITHUB_SHA' in (ROOT/'tools/in-container').read_text(),'GITHUB_SHA must cross the container boundary'
 print('PASS recorder-container-env-wiring',flush=True)
print('PASS recorder head guards; SKIP=0')
