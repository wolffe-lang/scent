#!/bin/bash
# Stage whole archive pair atomically; READY is the only completion signal.
set -euo pipefail
if [ "$#" -ne 3 ]; then echo 'usage: re-toolchain-stage WOLF_ARCHIVE LUPIN_ARCHIVE OUTPUT' >&2; exit 2; fi
wolf=$(realpath "$1")
lupin=$(realpath "$2")
out=$3
[ ! -e "$out" ] || { echo 'STOP: output already exists' >&2; exit 2; }
for pass in 1 2; do
    printf '%s  %s\n' 4cc4045bbbb605c07835bc4f32685953c784eeef4cd3139a48b457dfc90dad1a "$wolf" \
        ad703550ac4787e8e4bb26989d591a731410274d7332f2b4e8b9a64c878822cc "$lupin" | sha256sum --check -
done
stage="${out}.incoming.$$"
mkdir -p "$stage/wolf" "$stage/lupin"
tar -xzf "$wolf" -C "$stage/wolf"
tar -xzf "$lupin" -C "$stage/lupin"
[ "$(cat "$stage/wolf/wolf-0.2.35-x86_64-unknown-linux-gnu/std/STD-REV")" = 2386522eb059cca5a84108562c2c0a0e72345d34 ]
printf '%s\n' 'wolf 0.2.35 / lupin 0.1.56; complete archives verified twice' > "$stage/READY"
mv "$stage" "$out"
