#!/bin/bash
# Stage whole archive pair atomically; READY is the only completion signal.
set -euo pipefail
if [ "$#" -ne 3 ]; then echo 'usage: re-toolchain-stage WOLF_ARCHIVE LUPIN_ARCHIVE OUTPUT' >&2; exit 2; fi
wolf=$(realpath "$1")
lupin=$(realpath "$2")
out=$3
[ ! -e "$out" ] || { echo 'STOP: output already exists' >&2; exit 2; }
for pass in 1 2; do
    printf '%s  %s\n' d383c74c8cd123b9d9dfaa268271d4f004294f85c2b230237d0ef07027d9500d "$wolf" \
        34f52792bb59bc7565e0edc1235cd47d9a6ad13d5e6528993627f2e699b62193 "$lupin" | sha256sum --check -
done
stage="${out}.incoming.$$"
mkdir -p "$stage/wolf" "$stage/lupin"
tar -xzf "$wolf" -C "$stage/wolf"
tar -xzf "$lupin" -C "$stage/lupin"
[ "$(cat "$stage/wolf/wolf-0.2.36-x86_64-unknown-linux-gnu/std/STD-REV")" = 78b9d3cbc41d51db44d18c40b6694403644d1c83 ]
printf '%s\n' 'wolf 0.2.36 / lupin 0.1.58; complete archives verified twice' > "$stage/READY"
mv "$stage" "$out"
