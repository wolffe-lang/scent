#!/usr/bin/env python3
"""The PR gate must run the contract-size engine corpus, not a smoke size."""
from pathlib import Path
import runpy
import subprocess
import sys
ROOT=Path(__file__).resolve().parent.parent
plan=runpy.run_path(str(ROOT/'ci/tiers.py'))
size=int(subprocess.check_output([sys.executable,'-I',str(ROOT/'ci/tiers.py'),'regex-size']))
assert size>=20000, f'regex gate floor violated: {size} < 20000'
assert 'linux' in plan['PR_JOBS'], 'regex job is absent from tier pr'
workflow=(ROOT/'.github/workflows/ci.yml').read_text()
linux=workflow.split('\n  linux:\n',1)[1].split('\n  macos:\n',1)[0]
assert 'run: tools/in-container tools/re-ci' in linux, 'Linux PR job does not run engine gate'
script=(ROOT/'tools/re-ci').read_text()
assert 'ci/tiers.py regex-size' in script and '--soak "$pairs"' in script
assert 'tools/re-diagnostics' in script and 'tools/re-cost' in script and 'tools/re-projection-soak' in script
print(f'PASS regex CI wiring: {size} generated pairs per syntax plus diagnostics, units and costs')
