#!/usr/bin/env python3
"""Run module-local planted breaks, restoring source and binary in finally.
Only run under the lane's core lock inside its build container. A red gate
is required evidence, not a successful test of a bad binary.
"""
import argparse
import json
import os
from pathlib import Path
import runpy
import subprocess

ROOT=Path(__file__).resolve().parent.parent
m=runpy.run_path(str(ROOT/'tools/re-oracle'))

def build(work,label):
    r=subprocess.run([str(ROOT/'tools/re-driver')],capture_output=True,timeout=120,cwd=ROOT)
    (work/(label+'-build.log')).write_bytes(r.stdout+r.stderr)
    if r.returncode:raise RuntimeError(f'{label} build failed: {r.returncode}')


def leftmost(work,label):
    row=dict(syntax='extended',flags=[],patterns=[b'a|ab'],lines=[b'ab'])
    actual=m['driver_rows'](str(ROOT/'target/re/driver'),[row],work)[0]
    expected=m['oracle_row'](str(ROOT/'.oracle/grep'),row)
    (work/(label+'-result.json')).write_text(json.dumps(dict(engine=actual,oracle=expected),default=m['encode'],indent=2)+'\n')
    return actual==expected


def main():
    ap=argparse.ArgumentParser();ap.add_argument('--work',type=Path,required=True);a=ap.parse_args();a.work.mkdir(parents=True,exist_ok=True)
    linear=ROOT/'src/re/linear.lu';compiler=ROOT/'src/re/compile.lu';backref=ROOT/'src/re/backref.lu'
    original_linear=linear.read_text();original_compiler=compiler.read_text();original_backref=backref.read_text()
    try:
        old='if any_match { return Span { lo: start, hi: pos } }'
        assert original_linear.count(old)==1
        linear.write_text(original_linear.replace(old,'if any_match || nonempty { return Span { lo: start, hi: pos } }'))
        build(a.work,'leftmost-planted')
        if leftmost(a.work,"leftmost-red"):raise RuntimeError('plant survived: shortest-first was not detected')
        print('RED leftmost plant: a|ab on ab returned the shorter first alternative; oracle comparison rejected it',flush=True)
        linear.write_text(original_linear)
        build(a.work,'leftmost-restored')
        if not leftmost(a.work,"leftmost-green"):raise RuntimeError('restored leftmost gate is red')
        print('GREEN leftmost gate after restoring longest-span execution',flush=True)
        old='(mut re.backrefs).push(p.has_ref)'
        assert original_compiler.count(old)==1
        compiler.write_text(original_compiler.replace(old,'(mut re.backrefs).push(true)'))
        guard='if use_projection && ws.feasible[index] == 0 {'
        assert original_backref.count(guard)==1
        backref.write_text(original_backref.replace(guard,'if !use_projection && ws.feasible[index] == 0 {'))
        build(a.work,'backtracking-planted')
        command=['python3','-I',str(ROOT/'tools/re-cost'),'--plant-smoke','--ceiling','1','--work',str(a.work/'backtracking-planted')]
        r=subprocess.run(command,capture_output=True,timeout=30)
        (a.work/'backtracking-red.log').write_bytes(r.stdout+r.stderr)
        if r.returncode==0:raise RuntimeError('plant survived: regular-pattern backtracking did not fail cost gate')
        print('RED cost plant: regular (a|aa)*c routed through DFS without projection; bounded cost gate rejected it',flush=True)
        compiler.write_text(original_compiler)
        backref.write_text(original_backref)
        build(a.work,'backtracking-restored')
        command[-1]=str(a.work/'backtracking-restored')
        r=subprocess.run(command,capture_output=True,timeout=30)
        (a.work/'backtracking-green.log').write_bytes(r.stdout+r.stderr)
        if r.returncode:raise RuntimeError('restored cost gate is red')
        print('GREEN cost gate after restoring state-set dispatch',flush=True)
    finally:
        linear.write_text(original_linear);compiler.write_text(original_compiler);backref.write_text(original_backref)
        build(a.work,'final-restored')
    print('PASS both plants seen red then green; sources and driver restored',flush=True)
    return 0
if __name__=='__main__':raise SystemExit(main())
