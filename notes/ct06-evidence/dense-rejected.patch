+// Assertion-free C programs need neither scalar decoding nor context-key
+// arithmetic on a cached edge. Keep the cold subset construction unchanged.
+fn dfa_bytes(re: Regex, mut ws: Workspace, bytes: List[byte], lo: int, hi: int) -> bool ! {
+    fallback,
+} {
+    var state = 0
+    var pos = lo
+    while pos <= hi {
+        let cp = if pos < hi then bytes[pos] as int else -1
+        var next = ws.dfa.dense[state][cp + 1] - 3
+        if next == -3 {
+            if ws.dfa.entries >= 4096 { ws.dfa.enabled = false; return fallback }
+            next = dfa_step(re, mut ws, state, bytes, lo, hi, pos, cp, false, false)?
+            ws.dfa.dense[state][cp + 1] = next + 3
+            ws.dfa.entries += 1
+        }
+        if next == -2 { return true }
+        if pos == hi { return false }
+        state = next
+        pos += 1
+    }
+    false
+}
