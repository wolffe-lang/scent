+// Boolean one-pattern selection does not need the span cursor or its
+// leftmost-longest bookkeeping. The last byte indexes a bounded skip table.
+fn single_matches(re: Matcher, buf: List[byte], lo: int, hi: int) -> bool {
+    let size = re.patterns[0].bytes.len
+    var at = lo
+    while at + size <= hi {
+        let last = folded(buf[at + size - 1], re.flags.ignore_case)
+        if last == re.patterns[0].bytes[size - 1] {
+            var i = 0
+            while i < size && folded(buf[at + i], re.flags.ignore_case) == re.patterns[0].bytes[i] {
+                i += 1
+            }
+            if i == size && candidate(re, buf, lo, hi, at, at + size) { return true }
+        }
+        at += re.patterns[0].shifts[last as int]
+    }
+    false
+}
