//! member: false

use utf8

fn main() {
    let text = "aéα中𐀀\u{10ffff}"
    var at = 0
    for cp in [97, 233, 945, 20013, 65536, 1114111] {
        let (got, n) = utf8.next(text.bytes(), at, text.len)
        assert(got == cp)
        at += n
        assert(utf8.previous(text.bytes(), 0, at) == cp)
    }
    assert(at == text.len && !utf8.invalid(text.bytes(), 0, text.len))
    for bytes in [
        [128 as byte],
        [192 as byte, 175 as byte],
        [224 as byte, 128 as byte, 175 as byte],
        [237 as byte, 160 as byte, 128 as byte],
        [244 as byte, 144 as byte, 128 as byte, 128 as byte],
        [241 as byte, 128 as byte, 128 as byte],
        [225 as byte, 65 as byte, 128 as byte],
    ] {
        assert(utf8.invalid(bytes, 0, bytes.len))
        let (cp, n) = utf8.next(bytes, 0, bytes.len)
        assert(cp == 1114112 + bytes[0] as int && n == 1)
    }
    let raw = [195 as byte, 169 as byte]
    assert(utf8.invalid(raw, 0, 1))
    assert(utf8.previous(raw, 0, 1) == 1114307)
    assert(utf8.previous(raw, 1, 2) == 1114281)
    let (empty, n) = utf8.next(raw, 1, 1)
    assert(empty == 0 && n == 0)
}
