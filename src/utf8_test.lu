//! member: false

use re

fn main() {
    let text = "aéα中𐀀\u{10ffff}"
    var at = 0
    for cp in [97, 233, 945, 20013, 65536, 1114111] {
        let (got, n) = re.next(text.bytes(), at, text.len)
        assert(got == cp)
        at += n
        assert(re.previous(text.bytes(), 0, at) == cp)
    }
    assert(at == text.len && !re.strict_invalid(text.bytes(), 0, text.len))
    for bytes in [
        [128 as byte],
        [192 as byte, 175 as byte],
        [224 as byte, 128 as byte, 175 as byte],
        [237 as byte, 160 as byte, 128 as byte],
        [244 as byte, 144 as byte, 128 as byte, 128 as byte],
        [241 as byte, 128 as byte, 128 as byte],
        [225 as byte, 65 as byte, 128 as byte],
    ] {
        assert(re.strict_invalid(bytes, 0, bytes.len))
        let (cp, n) = re.next(bytes, 0, bytes.len)
        assert(cp == 2147483648 + bytes[0] as int && n == 1)
    }
    let raw = [195 as byte, 169 as byte]
    assert(re.strict_invalid(raw, 0, 1))
    assert(re.previous(raw, 0, 1) == 2147483843)
    assert(re.previous(raw, 1, 2) == 2147483817)
    let (empty, n) = re.next(raw, 1, 1)
    assert(empty == 0 && n == 0)
}
