//! member: false

use out

fn main() {
    // One buffer made outside the regions it is written in, as a run's is; its
    // bytes stay pending across them until a block fills or the run ends.
    var writer = out.create()
    assert(writer.buf.len == 4096 && writer.used == 0 && !writer.failed && !writer.lines)
    for i in 0..2 {
        region chunk {
            let b = "abc".bytes()
            out.window(mut writer, b, 0, b.len)
        }
    }
    assert(writer.used == 6 && writer.buf[0] == 97 as byte && writer.buf[5] == 99 as byte)
    // Nothing pending: the flush before a message has nothing to write.
    var quiet = out.create()
    out.before_message(mut quiet)
    assert(quiet.used == 0 && quiet.held == 0 && !quiet.failed)
    assert(!out.finish(mut quiet))
    print("output: 3 cases, 0 SKIP")
}
