//! member: false

use bytefind

//! Search boundaries must preserve LF, NUL and the no-terminator carry.

fn main() {
    let bytes = "abc\x00d\nef".bytes()
    assert(bytefind.find(bytes, 0, 0 as byte) == 3)
    assert(bytefind.find(bytes, 0, 120 as byte) == bytes.len)
    assert(bytefind.next_end(bytes, 0, 10 as byte, false) == 5)
    assert(bytefind.next_end(bytes, 0, 10 as byte, true) == 3)
    assert(bytefind.next_end(bytes, 4, 10 as byte, true) == 5)
    assert(bytefind.next_end(bytes, 0, 0 as byte, false) == 3)
    assert(bytefind.next_end(bytes, 6, 10 as byte, false) == bytes.len)
    assert(bytefind.next_end(bytes, bytes.len, 10 as byte, true) == bytes.len)
    // Every tail width and every start position, not just aligned blocks.
    var size = 0
    while size <= 20 {
        var needle_at = 0
        while needle_at <= size {
            var sample = List[byte]()
            var i = 0
            while i < size {
                (mut sample).push(if i == needle_at then 10 as byte else 120 as byte)
                i += 1
            }
            var start = 0
            while start <= size {
                let want = if needle_at >= start then needle_at else size
                assert(bytefind.find(sample, start, 10 as byte) == want)
                start += 1
            }
            needle_at += 1
        }
        size += 1
    }
    // Past the vector width: every needle place, from starts on both sides of
    // each 16-byte edge.
    size = 21
    while size <= 70 {
        var needle_at = 0
        while needle_at <= size {
            var sample = List[byte]()
            var i = 0
            while i < size {
                (mut sample).push(if i == needle_at then 10 as byte else 120 as byte)
                i += 1
            }
            for start in [0, 1, 15, 16, 17, 31, 32, 33, size - 1, size] {
                if start <= size {
                    let want = if needle_at >= start then needle_at else size
                    assert(bytefind.find(sample, start, 10 as byte) == want)
                }
            }
            needle_at += 1
        }
        size += 1
    }
    // The literal search against a scalar definition: every needle of one to
    // four bytes over every window of a small alphabet, each start and end,
    // by the vector search for the needle's rarest byte and, once a read has
    // had its fill of candidates that were not the needle, by the Horspool loop.
    let text = "abaabcabcdaabbccd\nabcdd".bytes()
    for needle_text in [
        "a",
        "d",
        "ab",
        "abc",
        "abcd",
        "bcd",
        "dd",
        "da",
        "cab",
        "x",
        "aab",
        "abab",
        "bb",
    ] {
        let needle = needle_text.bytes()
        let shifts = bytefind.literal_shifts(needle)
        let rare = bytefind.rare_index(needle)
        var from = 0
        while from <= text.len {
            var hi = from
            while hi <= text.len {
                var want = -1
                var at = from
                while want < 0 && at + needle.len <= hi {
                    var i = 0
                    while i < needle.len && text[at + i] == needle[i] { i += 1 }
                    if i == needle.len { want = at }
                    at += 1
                }
                var fresh = bytefind.misses()
                assert(
                    bytefind.find_literal(text, from, hi, needle, shifts, rare, mut fresh) == want,
                )
                var spent = bytefind.misses()
                spent.count = 1000
                assert(
                    bytefind.find_literal(text, from, hi, needle, shifts, rare, mut spent) == want,
                )
                hi += 1
            }
            from += 1
        }
    }
    // The search byte: the rarest by the table, the later one on a tie.
    assert(bytefind.rare_index("needle".bytes()) == 4)
    assert(bytefind.rare_index("zebra".bytes()) == 0)
    assert(bytefind.rare_index("quiz".bytes()) == 3)
    assert(bytefind.rare_index("fizzy".bytes()) == 3)
    assert(bytefind.rare_index("ab".bytes()) == 1)
    assert(bytefind.rare_index("a1".bytes()) == 1)
    // A candidate that is not the needle counts toward the guard; a found
    // needle does not.
    var count_misses = bytefind.misses()
    let ls = "lllll needle".bytes()
    let nd = "needle".bytes()
    assert(
        bytefind.find_literal(
            ls,
            0,
            ls.len,
            nd,
            bytefind.literal_shifts(nd),
            4,
            mut count_misses,
        ) ==
            6,
    )
    assert(count_misses.count == 1)
}
