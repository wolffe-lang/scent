//! member: true

// Clean-room: GNU 3.12 manual and black-box directory/identity probes.
use std.fs
use glob
use matcher
use opts
use out
use reader

struct State {
    matched: bool,
    error: bool,
    grouped: bool,
}

struct Identity { dev: int, ino: int }

fn input(path: str) -> int ! {not_found, denied, io} {
    if path == "-" { return 0 }
    fs_open(path)?
}

fn scan(o: opts.Options, re: matcher.Matcher, path: str, mut state: State) {
    let name = if path == "-" then o.label else path
    let fd = input(path) else |_| {
        let code = os_error()
        if !o.silent { eprint("{opts.program()}: {path}: {os_error_text(code)}") }
        state.error = true
        return
    }
    let info = fs_fstat(fd) else [2, 0, 0]
    if o.limit == 0 && info[0] != 1 {
        var writer = out.create()
        if o.count && o.listing == 0 && !o.quiet { out.count(mut writer, o, name, 0) }
        if o.listing == 2 && !o.quiet { out.filename(mut writer, o, name) }
        out.flush(mut writer)
        if writer.failed { state.error = true }
        if fd != 0 { fs_close(fd) else |_| {} }
        return
    }
    if !o.quiet && !o.count && o.listing == 0 {
        let input_info = fs_fstat_record(fd) else List[int]()
        let output_info = fs_fstat_record(1) else List[int]()
        if input_info.len > 10 &&
            output_info.len > 10 &&
            input_info[0] == 0 &&
            output_info[0] == 0 &&
            input_info[9] == output_info[9] &&
            input_info[10] == output_info[10] {
            if !o.silent {
                eprint("{opts.program()}: {name}: input file is also the output")
            }
            state.error = true
            if fd != 0 { fs_close(fd) else |_| {} }
            return
        }
    }
    let result = reader.scan(o, re, fd, name, path == "-", mut state.grouped)
    if fd != 0 { fs_close(fd) else |_| {} }
    if result.matched { state.matched = true }
    if result.error { state.error = true }
}

fn excluded(o: opts.Options, path: str, basename: str, root: bool, directory: bool) -> bool {
    if directory {
        for pattern in o.exclude_dirs {
            if root && glob.operand(pattern, path.bytes()) ||
                !root && glob.matches(pattern, basename.bytes()) {
                return true
            }
        }
        return false
    }
    if o.filters.len == 0 { return false }
    var include = !o.filters[0].include
    for f in o.filters {
        if root && glob.operand(f.pattern, path.bytes()) ||
            !root && glob.matches(f.pattern, basename.bytes()) {
            include = f.include
        }
    }
    !include
}

fn visit(
    flags: opts.Options,
    re: matcher.Matcher,
    path: str,
    basename: str,
    root: bool,
    ancestors: List[Identity],
    mut state: State,
) {
    if flags.quiet && state.matched { return }
    if path == "-" && root { scan(flags, re, path, mut state); return }
    let link = fs.lstat(path) else |_| {
        if excluded(flags, path, basename, root, false) { return }
        if !flags.silent { eprint("{opts.program()}: {path}: {os_error_text(os_error())}") }
        state.error = true
        return
    }
    if link.kind == 3 && !root && !flags.dereference { return }
    var info = link
    if info.kind == 3 {
        info = fs.stat(path) else |_| {
            if excluded(flags, path, basename, root, false) { return }
            if !flags.silent { eprint("{opts.program()}: {path}: {os_error_text(os_error())}") }
            state.error = true
            return
        }
    }
    if excluded(flags, path, basename, root, info.kind == 1) { return }
    if info.kind == 1 {
        if flags.directories == 2 { return }
        if flags.directories == 1 {
            for previous in ancestors {
                if previous.dev == info.dev && previous.ino == info.ino {
                    if !flags.silent {
                        eprint("{opts.program()}: {path}: warning: recursive directory loop")
                    }
                    return
                }
            }
            let entries = fs.entries(path) else |_| {
                if !flags.silent { eprint("{opts.program()}: {path}: {os_error_text(os_error())}") }
                state.error = true
                return
            }
            var stack = copy ancestors
            (mut stack).push(Identity { dev: info.dev, ino: info.ino })
            var o = copy flags
            if o.filename_auto { o.filename = 1 }
            for entry in entries {
                region child {
                    let name = str_from_utf8(entry.name) else |_| {
                        eprint("{opts.program()}: directory entry is not UTF-8")
                        state.error = true
                        continue
                    }
                    let child = if flags.implicit_tree && root then name else fs.join(path, name)
                    visit(o, re, child, name, false, stack, mut state)
                }
                if flags.quiet && state.matched { return }
            }
            return
        }
    } else if info.kind != 0 &&
        (flags.devices == 1 || flags.devices < 0 && !root && !flags.dereference) {
        return
    }
    scan(flags, re, path, mut state)
}

/// Stream depth-first over raw directory entries, retaining ancestor
/// identities only for loop detection. Never sort directory results.
pub fn run(o: opts.Options, re: matcher.Matcher) -> int {
    if o.limit == 0 && o.listing != 2 { return 1 }
    var state = State { matched: false, error: false, grouped: false }
    let ancestors = List[Identity]()
    for path in o.files {
        region operand {
            let basename = fs.file_name(path) else path
            visit(o, re, path, basename, true, ancestors, mut state)
        }
        if o.quiet && state.matched { return 0 }
    }
    if state.error { return 2 }
    if state.matched { return 0 }
    1
}
