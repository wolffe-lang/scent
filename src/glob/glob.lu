//! member: true

// Clean-room: POSIX fnmatch pattern notation and pinned GNU 3.12 probes.

fn member(b: int, name: str) -> bool {
    let lower = b >= 97 && b <= 122
    let upper = b >= 65 && b <= 90
    let digit = b >= 48 && b <= 57
    let space = b == 32 || b >= 9 && b <= 13
    match name {
        "alnum" => lower || upper || digit,
        "alpha" => lower || upper,
        "blank" => b == 32 || b == 9,
        "cntrl" => b < 32 || b == 127,
        "digit" => digit,
        "graph" => b >= 33 && b <= 126,
        "lower" => lower,
        "print" => b >= 32 && b <= 126,
        "punct" => b >= 33 && b <= 126 && !lower && !upper && !digit,
        "space" => space,
        "upper" => upper,
        "xdigit" => digit || b >= 65 && b <= 70 || b >= 97 && b <= 102,
        _ => false,
    }
}

fn atom(p: List[byte], start: int) -> (int, int) {
    let c = p[start] as int
    if c == 92 && start + 1 < p.len { return (p[start + 1] as int, start + 2) }
    if c == 91 && start + 1 < p.len && (p[start + 1] == 46 as byte || p[start + 1] == 61 as byte) {
        let marker = p[start + 1]
        var end = start + 2
        while end + 1 < p.len {
            if p[end] == marker && p[end + 1] == 93 as byte {
                return (if end == start + 3 then p[start + 2] as int else -256, end + 2)
            }
            end += 1
        }
    }
    (c, start + 1)
}

// Return the position after a valid bracket, negative when it does not
// match, zero for an unclosed bracket (which is an ordinary '[').
fn bracket(p: List[byte], start: int, b: int) -> int {
    var at = start + 1
    var negate = false
    if at < p.len && (p[at] == 33 as byte || p[at] == 94 as byte) {
        negate = true
        at += 1
    }
    var hit = false
    let first = at
    while at < p.len {
        let c = p[at] as int
        if c == 93 && at > first { return if hit != negate then at + 1 else -(at + 1) }
        if c == 91 && at + 1 < p.len && p[at + 1] == 58 as byte {
            var end = at + 2
            while end + 1 < p.len && !(p[end] == 58 as byte && p[end + 1] == 93 as byte) {
                end += 1
            }
            if end + 1 == p.len { return 0 }
            let name = str_from_utf8(p[at + 2..end]) else ""
            if member(b, name) { hit = true }
            at = end + 2
            continue
        }
        let (lo, next) = atom(p, at)
        at = next
        if at + 1 < p.len && p[at] == 45 as byte && p[at + 1] != 93 as byte {
            at += 1
            let (hi, next) = atom(p, at)
            at = next
            if b >= lo && b <= hi { hit = true }
        } else if b == lo {
            hit = true
        }
    }
    0
}

/// Match a complete name; slash and leading dot are ordinary bytes.
pub fn matches(p: List[byte], text: List[byte]) -> bool {
    var at = 0
    var pos = 0
    var star = -1
    var retry = 0
    while pos < text.len {
        if at < p.len && p[at] == 42 as byte {
            star = at
            retry = pos
            at += 1
            continue
        }
        var next = at + 1
        var hit = false
        if at < p.len {
            let c = p[at] as int
            let b = text[pos] as int
            if c == 63 {
                hit = true
            } else if c == 91 {
                let end = bracket(p, at, b)
                if end == 0 {
                    hit = b == 91
                } else {
                    hit = end > 0
                    next = if end > 0 then end else -end
                }
            } else if c == 92 {
                if next < p.len { hit = p[next] as int == b; next += 1 }
            } else {
                hit = c == b
            }
        }
        if hit {
            at = next
            pos += 1
            continue
        }
        if star >= 0 && retry < text.len {
            retry += 1
            pos = retry
            at = star + 1
            continue
        }
        return false
    }
    while at < p.len && p[at] == 42 as byte { at += 1 }
    at == p.len
}

/// Explicit operands also try suffixes beginning after a slash.
pub fn operand(pattern: List[byte], path: List[byte]) -> bool {
    if matches(pattern, path) { return true }
    var at = 0
    while at < path.len {
        if path[at] == 47 as byte && matches(pattern, path[at + 1..]) { return true }
        at += 1
    }
    false
}
