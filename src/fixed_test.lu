//! member: false

use fixed

fn check(patterns: str, data: str, icase: bool, word: bool, whole: bool, lo: int, hi: int) {
    var ps = List[List[byte]]()
    for p in patterns.split("\n") {
        (mut ps).push(p.bytes())
    }
    let re = fixed.compile(ps, fixed.
        Flags { ignore_case: icase, word: word, whole: whole, utf8: false, terminator: 10 as byte })
    var ws = fixed.workspace_new(re)
    let b = data.bytes()
    let span = fixed.next_span(re, mut ws, b, 0, b.len, 0) else |_| {
        assert(lo < 0)
        return
    }
    assert(span.lo == lo)
    assert(span.hi == hi)
    assert(fixed.line_matches(re, mut ws, b, 0, b.len))
}

fn main() {
    check("ab", "xabab", false, false, false, 1, 3)
    check("a\nab", "xabab", false, false, false, 1, 3)
    check("a-\na", "a-b", false, true, false, 0, 1)
    check("ABA", "ababa", true, false, false, 0, 3)
    check("aba", "xababa aba", false, true, false, 7, 10)
    let empty = fixed.compile([List[byte]()], fixed.Flags {
        ignore_case: false,
        word: false,
        whole: false,
        utf8: false,
        terminator: 10 as byte,
    })
    var scratch = fixed.workspace_new(empty)
    assert(fixed.line_matches(empty, mut scratch, "x".bytes(), 0, 1))
    let absent = fixed.next_span(empty, mut scratch, "x".bytes(), 0, 1, 0) else fixed.Span {
        lo: -1,
        hi: -1,
    }
    assert(absent.lo == -1)
    check("x", "xx", false, false, true, -1, -1)
    check("xx", "xx", false, true, true, 0, 2)
    check("\x00", "a\x00b", false, false, false, 1, 2)
    let multi = fixed.compile(["NEVER".bytes(), "a".bytes()], fixed.Flags {
        ignore_case: false,
        word: false,
        whole: false,
        utf8: false,
        terminator: 10 as byte,
    })
    var cursor = fixed.workspace_new(multi)
    let line = "aaaa".bytes()
    for i in 0..4 {
        let hit = fixed.next_span(multi, mut cursor, line, 0, line.len, i) else fixed.Span {
            lo: -1,
            hi: -1,
        }
        assert(hit.lo == i && hit.hi == i + 1)
    }
    let rewind = fixed.next_span(multi, mut cursor, line, 0, line.len, 1) else fixed.Span {
        lo: -1,
        hi: -1,
    }
    assert(rewind.lo == 1)
    print("fixed: 10 cases, 0 SKIP")
}
