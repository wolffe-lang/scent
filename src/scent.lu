//! member: false

// Clean-room: POSIX.1-2024 grep, GNU grep 3.12 manual/help and black-box.
// ferp 7d332b5 src/ferp_cli.f90:23-147 is design reference, not a port.
use std.env
use fixed
use matcher
use opts
use out
use reader

fn input(path: str) -> int ! {not_found, denied, io} {
    if path == "-" { return 0 }
    fs_open(path)?
}

fn add_patterns(mut patterns: List[List[byte]], bytes: List[byte], explicit: bool, zero: bool) {
    var lo: int = 0
    var at: int = 0
    while at < bytes.len {
        if bytes[at] == 10 as byte || zero && bytes[at] == 0 as byte {
            (mut patterns).push(bytes[lo..at])
            lo = at + 1
        }
        at += 1
    }
    if lo < bytes.len || explicit { (mut patterns).push(bytes[lo..bytes.len]) }
}

fn help() {
    print("Usage: scent [OPTION]... PATTERNS [FILE]...")
    print("Find selected byte lines in files or standard input.")
    print("  -F                 use literal patterns (C locale)")
    print("  -e PATTERN -f FILE  add patterns, or read one per newline")
    print("  -i -w -x -v        fold ASCII case, word/line matching, invert")
    print("  -c -l -L -o -q -s  count, list, spans, quiet, suppress file errors")
    print("  -n -b -H -h -T -Z  line/byte/file prefixes, alignment, NUL names")
    print("  -A N -B N -C N     surrounding lines and configurable groups")
    print("  -m N -z -a -I      match limit, NUL lines, binary policy")
    print("  --label=NAME       standard-input label; --line-buffered flushes lines")
    print("  --help --version   show this summary or scent's version")
    print("Basic/extended syntax joins in ct02; recursion and colour in M2.")
    print("Exit: 0 when a line is selected, 1 otherwise, 2 on error.")
}

fn run(o: opts.Options) -> int {
    if o.status >= 0 { return o.status }
    if o.action == "help" { help(); return 0 }
    if o.action == "version" {
        print("scent 0.1.0")
        print("GPL-3.0-or-later with the wolf Training Data Permission.")
        return 0
    }
    if o.not_yet != "" { eprint("scent: not yet implemented: {o.not_yet}"); return 2 }
    var patterns = List[List[byte]]()
    for source in o.sources {
        if !source.file {
            add_patterns(mut patterns, source.text.bytes(), true, o.zero)
        } else {
            let fd = input(source.text) else |_| {
                eprint("{opts.program()}: {source.text}: {os_error_text(os_error())}")
                return 2
            }
            var all = List[byte]()
            loop {
                let chunk = fs_read_chunk(fd, 65536) else |e| match e {
                    eof => { break },
                    io => {
                        eprint("{opts.program()}: {source.text}: {os_error_text(os_error())}")
                        return 2
                    },
                }
                for b in chunk { (mut all).push(b) }
            }
            if fd != 0 { fs_close(fd) else |_| {} }
            add_patterns(mut patterns, all, false, o.zero)
        }
    }
    if o.syntax == "P" {
        eprint("{opts.program()}: Perl matching not supported in a --disable-perl-regexp build")
        return 2
    }
    if o.syntax != "F" { eprint("scent: basic and extended patterns arrive with ct02"); return 2 }
    let re = matcher.compile(patterns, o.syntax, fixed.Flags {
        ignore_case: o.ignore_case,
        word: o.word,
        whole: o.whole,
        terminator: if o.zero then 0 as byte else 10 as byte,
    }) else |_| { return 2 }
    var matched = false
    var error = false
    var grouped = false
    for path in o.files {
        region file {
            let name = if path == "-" then o.label else path
            if o.limit == 0 {
                var writer = out.create()
                if o.count && o.listing == 0 && !o.quiet { out.count(mut writer, o, name, 0) }
                if o.listing == 2 && !o.quiet { out.filename(mut writer, o, name) }
                out.flush(mut writer)
                if writer.failed { error = true }
                continue
            }
            let fd = input(path) else |_| {
                let code = os_error()
                if !o.silent { eprint("{opts.program()}: {path}: {os_error_text(code)}") }
                error = true
                continue
            }
            if !o.quiet && !o.count && o.listing == 0 {
                let input_path = if path == "-" then "/dev/stdin" else path
                let input_info = fs_stat(input_path) else List[int]()
                let output_info = fs_stat("/dev/stdout") else List[int]()
                if input_info.len > 10 &&
                    output_info.len > 10 &&
                    input_info[0] == 0 &&
                    output_info[0] == 0 &&
                    input_info[9] == output_info[9] &&
                    input_info[10] == output_info[10] {
                    if !o.silent {
                        eprint("{opts.program()}: {name}: input file is also the output")
                    }
                    error = true
                    if fd != 0 { fs_close(fd) else |_| {} }
                    continue
                }
            }
            let result = reader.scan(o, re, fd, name, path == "-", mut grouped)
            if fd != 0 { fs_close(fd) else |_| {} }
            if result.matched { matched = true }
            if result.error { error = true }
            if o.quiet && matched { return 0 }
        }
    }
    if error { return 2 }
    if matched { return 0 }
    1
}

fn main() -> int {
    run(opts.parse(env_args(), env.has("POSIXLY_CORRECT")))
}
