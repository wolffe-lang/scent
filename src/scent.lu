//! member: false

// Clean-room: POSIX.1-2024 grep, GNU grep 3.12 manual/help and black-box.
// ferp 7d332b5 src/ferp_cli.f90:23-147 is design reference, not a port.
use std.env
use colors
use fixed
use matcher
use opts
use walk
use re

fn input(path: str) -> int ! {not_found, denied, io} {
    if path == "-" { return 0 }
    fs_open(path)?
}

fn add_patterns(mut patterns: List[List[byte]], bytes: List[byte], explicit: bool) {
    var lo: int = 0
    var at: int = 0
    while at < bytes.len {
        if bytes[at] == 10 as byte {
            (mut patterns).push(bytes[lo..at])
            lo = at + 1
        }
        at += 1
    }
    if lo < bytes.len || explicit { (mut patterns).push(bytes[lo..bytes.len]) }
}

fn help() {
    print("Usage: {opts.program()} [OPTION]... PATTERNS [FILE]...")
    print("Find selected byte lines in files or standard input.")
    print("  -F                 use literal patterns (C locale)")
    print("  -e PATTERN -f FILE  add patterns, or read one per newline")
    print("  -i -w -x -v        fold ASCII case, word/line matching, invert")
    print("  -c -l -L -o -q -s  count, list, spans, quiet, suppress file errors")
    print("  -n -b -H -h -T -Z  line/byte/file prefixes, alignment, NUL names")
    print("  -A N -B N -C N     surrounding lines and configurable groups")
    print("  -m N -z -a -I      match limit, NUL lines, binary policy")
    print("  --label=NAME       standard-input label; --line-buffered flushes lines")
    print("  -r -R -d -D        recursive, directory and device handling")
    print("  --include --exclude --exclude-dir --exclude-from   file selection")
    print("  --color[=WHEN]     always, never or automatic terminal highlighting")
    print("  --help --version   show this summary or scent's version")
    print("C-locale basic, extended and fixed patterns; recursive search and colour.")
    print("Exit: 0 when a line is selected, 1 otherwise, 2 on error.")
}

fn emit_diagnostics(d: re.Diagnostics, names: List[str], lines: List[int]) {
    for item in d.items {
        fs_write_chunk(2, "{opts.program()}: ".bytes()) else |_| {}
        if !item.warning && item.pattern < names.len && names[item.pattern] != "" {
            fs_write_chunk(2, "{names[item.pattern]}:{lines[item.pattern]}: ".bytes()) else |_| {}
        }
        fs_write_chunk(2, item.text) else |_| {}
        fs_write_chunk(2, [10 as byte]) else |_| {}
    }
}

fn run(initial: opts.Options) -> int {
    var o = initial
    if o.status >= 0 { return o.status }
    if o.action == "help" { help(); return 0 }
    if o.action == "version" {
        print("scent 0.1.0")
        print("GPL-3.0-or-later with the wolf Training Data Permission.")
        return 0
    }
    var locale = env.get("LC_ALL") else ""
    if locale == "" { locale = env.get("LC_CTYPE") else "" }
    if locale == "" { locale = env.get("LANG") else "" }
    if locale.contains("UTF-8") || locale.contains("utf8") || locale.contains("utf-8") {
        o.not_yet = "UTF-8 locale semantics (M3)"
    }
    if o.not_yet != "" { eprint("{opts.program()}: not yet implemented: {o.not_yet}"); return 2 }
    o.colors = colors.configure(o.color_when, opts.program())
    var patterns = List[List[byte]]()
    var source_names = List[str]()
    var source_lines = List[int]()
    for source in o.sources {
        let first = patterns.len
        if !source.file {
            add_patterns(mut patterns, source.text.bytes(), true)
        } else {
            let fd = input(source.text) else |_| {
                eprint("{opts.program()}: {source.text}: {os_error_text(os_error())}")
                return 2
            }
            var all = List[byte]()
            loop {
                let chunk = fs_read_chunk(fd, 65536) else |e| match e {
                    eof => { break },
                    io => {
                        eprint("{opts.program()}: {source.text}: {os_error_text(os_error())}")
                        return 2
                    },
                }
                for b in chunk { (mut all).push(b) }
            }
            if fd != 0 { fs_close(fd) else |_| {} }
            add_patterns(mut patterns, all, false)
        }
        var idx = first
        while idx < patterns.len {
            (mut source_names).push(if source.file then source.text else "")
            (mut source_lines).push(idx - first + 1)
            idx += 1
        }
    }
    var unique = List[List[byte]]()
    var names = List[str]()
    var lines = List[int]()
    var pi = 0
    while pi < patterns.len {
        var duplicate = false
        for previous in unique {
            if previous.len == patterns[pi].len {
                var equal = true
                var bi = 0
                while bi < previous.len {
                    if previous[bi] != patterns[pi][bi] { equal = false; break }
                    bi += 1
                }
                if equal { duplicate = true; break }
            }
        }
        if !duplicate {
            (mut unique).push(copy patterns[pi])
            (mut names).push(source_names[pi])
            (mut lines).push(source_lines[pi])
        }
        pi += 1
    }
    if o.syntax == "P" {
        eprint("{opts.program()}: Perl matching not supported in a --disable-perl-regexp build")
        return 2
    }
    var diagnostics = re.diagnostics_new()
    let re = matcher.compile(
        unique,
        o.syntax,
        fixed.Flags {
            ignore_case: o.ignore_case,
            word: o.word,
            whole: o.whole,
            terminator: if o.zero then 0 as byte else 10 as byte,
        },
        mut diagnostics,
    ) else |_| {
        emit_diagnostics(diagnostics, names, lines)
        return 2
    }
    emit_diagnostics(diagnostics, names, lines)
    walk.run(o, re)
}

fn main() -> int {
    run(opts.parse(env_args(), env.has("POSIXLY_CORRECT")))
}
