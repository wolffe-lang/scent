//! The filter is a necessary condition, never an approximation of acceptance.

fn test_constant_capture_proof() {
    var d = diagnostics_new()
    let re = compile([r"n(e)\1dle".bytes()], filter_options(), mut d) else {
        assert(false)
        return
    }
    assert(re.filters[0].exact, "straight-line constant capture is exact")
    assert(re.filters[0].units.len == 6, "constant capture contributes its literal")
    for mode in [1, 2] {
        var options = filter_options()
        options.icase = mode == 1
        options.utf8 = mode == 2
        let fallback = compile([r"n(e)\1dle".bytes()], options, mut d) else {
            assert(false)
            return
        }
        for filter in fallback.filters {
            assert(!filter.exact, "folded and scalar references retain the VM")
        }
    }
    for pattern in [r"(a)?\1", r"(a|b)\1", r"(a*)\1", r"(a.)\1"] {
        let unknown = compile([pattern.bytes()], filter_options(), mut d) else {
            assert(false)
            return
        }
        for filter in unknown.filters {
            assert(!filter.exact, "conditional or nonconstant captures stay unknown")
        }
    }
}

fn filter_options() -> Options {
    Options {
        extended: true,
        icase: false,
        word: false,
        whole: false,
        utf8: false,
        terminator: 10 as byte,
    }
}

fn test_prefilter_retains_match() {
    var d = diagnostics_new()
    let re = compile(["n[e]edle".bytes()], filter_options(), mut d) else { assert(false); return }
    var ws = workspace_new(re)
    let b = "prefix needle suffix".bytes()
    assert(line_matches(re, mut ws, b, 0, b.len), "prefilter-retains-match")
    assert(re.filters[0].units.len == 6, "singleton class joins required literal")
}

fn test_prefilter_superset() {
    for pattern in [
        "ab|abc",
        "(ab)?c",
        r"(ab){2,3}",
        "a*",
        "(needle|hayneedle)",
        "ab.cd",
        "^ab$",
        "a\\bb",
        "((a|)b)*c",
        r"a{300}",
        r"(abc){100}",
        r"n(e)\1dle",
        r"(a(b))\2\1",
        r"()a\1",
        r"(a)?b\1",
        r"(a|b)\1",
        r"((a)*)\2",
        r"(a.)\1",
        r"(a)\1|b",
        r"^n(e)\1dle$",
    ] {
        var d = diagnostics_new()
        let re = compile([pattern.bytes()], filter_options(), mut d) else { assert(false); return }
        var fast = workspace_new(re)
        var slow = workspace_new(re)
        slow.prefilters = false
        slow.dfa.enabled = false
        for text in [
            "",
            "abc",
            "ab",
            "abab",
            "abababc",
            "abcabc",
            "hayneedle",
            "ab.cd",
            "aaaa",
            "a b",
            "needle",
            "xneedley",
            "abbab",
            "a",
            "aa",
            "bb",
            "aba",
        ] {
            let b = text.bytes()
            assert(
                line_matches(re, mut fast, b, 0, b.len) == line_matches(re, mut slow, b, 0, b.len),
                "prefilter superset",
            )
        }
    }
}
