//! Backreference-only depth-first execution. POSIX XBD 9.3.6 and GNU
//! info 3.5 define participation and last-capture semantics. No other
//! implementation consulted. R-ct01-2: this path has a separate high-water
//! stack; its storage can depend on input, unlike the linear state sets.
//! Captures are inline scalars, never an allocated list per branch.

struct Captures {
    c0: int,
    c1: int,
    c2: int,
    c3: int,
    c4: int,
    c5: int,
    c6: int,
    c7: int,
    c8: int,
    c9: int,
    c10: int,
    c11: int,
    c12: int,
    c13: int,
    c14: int,
    c15: int,
    c16: int,
    c17: int,
    c18: int,
    c19: int,
}

fn captures_new() -> Captures {
    Captures {
        c0: -1,
        c1: -1,
        c2: -1,
        c3: -1,
        c4: -1,
        c5: -1,
        c6: -1,
        c7: -1,
        c8: -1,
        c9: -1,
        c10: -1,
        c11: -1,
        c12: -1,
        c13: -1,
        c14: -1,
        c15: -1,
        c16: -1,
        c17: -1,
        c18: -1,
        c19: -1,
    }
}

fn capture_get(c: Captures, slot: int) -> int {
    if slot == 0 { return c.c0 }
    if slot == 1 { return c.c1 }
    if slot == 2 { return c.c2 }
    if slot == 3 { return c.c3 }
    if slot == 4 { return c.c4 }
    if slot == 5 { return c.c5 }
    if slot == 6 { return c.c6 }
    if slot == 7 { return c.c7 }
    if slot == 8 { return c.c8 }
    if slot == 9 { return c.c9 }
    if slot == 10 { return c.c10 }
    if slot == 11 { return c.c11 }
    if slot == 12 { return c.c12 }
    if slot == 13 { return c.c13 }
    if slot == 14 { return c.c14 }
    if slot == 15 { return c.c15 }
    if slot == 16 { return c.c16 }
    if slot == 17 { return c.c17 }
    if slot == 18 { return c.c18 }
    if slot == 19 { return c.c19 }
    -1
}

fn capture_set(mut c: Captures, slot: int, value: int) {
    if slot == 0 { c.c0 = value; return }
    if slot == 1 { c.c1 = value; return }
    if slot == 2 { c.c2 = value; return }
    if slot == 3 { c.c3 = value; return }
    if slot == 4 { c.c4 = value; return }
    if slot == 5 { c.c5 = value; return }
    if slot == 6 { c.c6 = value; return }
    if slot == 7 { c.c7 = value; return }
    if slot == 8 { c.c8 = value; return }
    if slot == 9 { c.c9 = value; return }
    if slot == 10 { c.c10 = value; return }
    if slot == 11 { c.c11 = value; return }
    if slot == 12 { c.c12 = value; return }
    if slot == 13 { c.c13 = value; return }
    if slot == 14 { c.c14 = value; return }
    if slot == 15 { c.c15 = value; return }
    if slot == 16 { c.c16 = value; return }
    if slot == 17 { c.c17 = value; return }
    if slot == 18 { c.c18 = value; return }
    if slot == 19 { c.c19 = value; return }
}

fn captures_equal(a: Captures, b: Captures) -> bool {
    a.c0 == b.c0 &&
        a.c1 == b.c1 &&
        a.c2 == b.c2 &&
        a.c3 == b.c3 &&
        a.c4 == b.c4 &&
        a.c5 == b.c5 &&
        a.c6 == b.c6 &&
        a.c7 == b.c7 &&
        a.c8 == b.c8 &&
        a.c9 == b.c9 &&
        a.c10 == b.c10 &&
        a.c11 == b.c11 &&
        a.c12 == b.c12 &&
        a.c13 == b.c13 &&
        a.c14 == b.c14 &&
        a.c15 == b.c15 &&
        a.c16 == b.c16 &&
        a.c17 == b.c17 &&
        a.c18 == b.c18 &&
        a.c19 == b.c19
}

struct BacktrackFrame {
    pc: int,
    pos: int,
    caps: Captures,
    stage: int,
}

fn branch_push(mut ws: Workspace, pc: int, pos: int, caps: Captures) {
    let frame = BacktrackFrame { pc: pc, pos: pos, caps: copy caps, stage: 0 }
    if ws.depth == ws.branches.len {
        (mut ws.branches).push(frame)
    } else {
        ws.branches[ws.depth] = frame
    }
    ws.depth += 1
    if ws.depth > ws.peak { ws.peak = ws.depth }
}

fn reference_end(
    re: Regex,
    inst: Inst,
    caps: Captures,
    bytes: List[byte],
    pos: int,
    hi: int,
) -> int {
    let start = capture_get(caps, 2 * inst.arg)
    let end = capture_get(caps, 2 * inst.arg + 1)
    if start < 0 || end < start || end - start > hi - pos { return -1 }
    var i = 0
    while i < end - start {
        let a = bytes[start + i] as int
        let b = bytes[pos + i] as int
        if re.options.icase {
            if ascii_fold(a) != ascii_fold(b) { return -1 }
        } else if a != b {
            return -1
        }
        i += 1
    }
    pos + end - start
}

fn backref_at(
    re: Regex,
    mut ws: Workspace,
    root: int,
    bytes: List[byte],
    lo: int,
    hi: int,
    origin: int,
    nonempty: bool,
    any_match: bool,
) -> int {
    ws.depth = 0
    branch_push(mut ws, root, origin, captures_new())
    var best = -1
    while ws.depth > 0 {
        let top = ws.depth - 1
        let pc = ws.branches[top].pc
        let pos = ws.branches[top].pos
        let inst = copy re.prog[pc]
        let stage = ws.branches[top].stage
        if stage > 0 {
            if inst.op == SPLIT && stage == 1 {
                ws.branches[top].stage = 2
                let caps = copy ws.branches[top].caps
                branch_push(mut ws, inst.y, pos, caps)
            } else {
                ws.depth -= 1
            }
            continue
        }
        var ancestor = top
        var cycle = false
        while ancestor > 0 {
            ancestor -= 1
            if ws.branches[ancestor].pos != pos { break }
            if ws.branches[ancestor].pc == pc &&
                captures_equal(ws.branches[ancestor].caps, ws.branches[top].caps) {
                cycle = true
                break
            }
        }
        if cycle { ws.depth -= 1; continue }
        ws.branches[top].stage = 1
        var caps = copy ws.branches[top].caps
        if inst.op == ACCEPT {
            if (!nonempty || pos > origin) &&
                (!re.options.whole || pos == hi) &&
                (!re.options.word || re.options.whole || pos == hi || !is_word(bytes[pos] as int)) {
                if any_match || pos == hi { return pos }
                if pos > best { best = pos }
            }
        } else if inst.op == SPLIT || inst.op == JUMP {
            branch_push(mut ws, inst.x, pos, caps)
        } else if inst.op == SAVE {
            capture_set(mut caps, inst.arg, pos)
            branch_push(mut ws, inst.x, pos, caps)
        } else if inst.op == REF {
            let end = reference_end(re, inst, caps, bytes, pos, hi)
            if end >= 0 { branch_push(mut ws, inst.x, end, caps) }
        } else if inst.op >= BOL && inst.op <= WORD_END {
            if assertion(inst.op, bytes, lo, hi, pos) { branch_push(mut ws, inst.x, pos, caps) }
        } else if pos < hi && consumes(re, inst, bytes[pos]) {
            branch_push(mut ws, inst.x, pos + 1, caps)
        }
    }
    best
}

fn find_span(
    re: Regex,
    mut ws: Workspace,
    bytes: List[byte],
    lo: int,
    hi: int,
    from: int,
    nonempty: bool,
    any_match: bool,
    use_projection: bool,
) -> Span ! {none} {
    assert(lo >= 0 && hi >= lo && hi <= bytes.len, "regex window out of bounds")
    var result = linear_span(re, mut ws, bytes, lo, hi, from, nonempty, any_match) else Span {
        lo: -1,
        hi: -1,
    }
    if any_match && result.lo >= 0 { return result }
    var index = 0
    while index < re.starts.len {
        if re.backrefs[index] {
            // Cached for the unchanged line: subsequent -o calls never rerun
            // a full-line projection for a missing backreference alternative.
            if use_projection && ws.feasible[index] == 0 {
                let possible = projection_matches(re, mut ws, index, bytes, lo, hi)
                ws.feasible[index] = if possible then 1 else -1
            }
            if use_projection && ws.feasible[index] < 0 { index += 1; continue }
            var start = if from < lo then lo else from
            while start <= hi && (result.lo < 0 || start <= result.lo) {
                if re.options.whole && start != lo { break }
                if !re.options.word ||
                    re.options.whole ||
                    start == lo ||
                    !is_word(bytes[start - 1] as int) {
                    let end = backref_at(
                        re,
                        mut ws,
                        program_start(re, index, nonempty),
                        bytes,
                        lo,
                        hi,
                        start,
                        nonempty,
                        any_match,
                    )
                    if end >= 0 {
                        if any_match { return Span { lo: start, hi: end } }
                        if result.lo < 0 ||
                            start < result.lo ||
                            start == result.lo && end > result.hi {
                            result = Span { lo: start, hi: end }
                        }
                        break
                    }
                }
                start += 1
            }
        }
        index += 1
    }
    if result.lo < 0 { return none }
    result
}

fn line_matches_mode(
    re: Regex,
    mut ws: Workspace,
    bytes: List[byte],
    lo: int,
    hi: int,
    use_projection: bool,
) -> bool {
    var i = 0
    while i < ws.feasible.len { ws.feasible[i] = 0; i += 1 }
    let result = find_span(re, mut ws, bytes, lo, hi, lo, false, true, use_projection) else {
        return false
    }
    result.lo >= lo
}

fn next_span_mode(
    re: Regex,
    mut ws: Workspace,
    bytes: List[byte],
    lo: int,
    hi: int,
    from: int,
    use_projection: bool,
) -> Span ! {none} {
    var consuming = false
    for inst in re.prog {
        if inst.op == CHAR || inst.op == CLASS || inst.op == ANY || inst.op == REF {
            consuming = true
            break
        }
    }
    if !consuming { return none }
    find_span(re, mut ws, bytes, lo, hi, from, true, false, use_projection)
}

/// Whether any pattern selects this line window, including an empty match.
/// Traps only for an invalid buffer window; reuse a workspace for this Regex.
pub fn line_matches(re: Regex, mut ws: Workspace, bytes: List[byte], lo: int, hi: int) -> bool {
    line_matches_mode(re, mut ws, bytes, lo, hi, true)
}

/// Precondition: line_matches selected this unchanged line with this workspace.
/// Return only nonempty, leftmost-longest spans; resume with the preceding hi.
/// Keep the original lo/hi window so anchors, word context and cached projection
/// decisions never shift. Empty-only programs return none without scanning.
pub fn next_span(
    re: Regex,
    mut ws: Workspace,
    bytes: List[byte],
    lo: int,
    hi: int,
    from: int,
) -> Span ! {none} {
    next_span_mode(re, mut ws, bytes, lo, hi, from, true)
}
