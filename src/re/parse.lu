//! Iterative BRE/ERE parser. Inputs: POSIX.1-2024 XBD 9.3/9.4;
//! GNU grep 3.12 info 3.1–3.7 and tools/re-probe observations.
//! Design reference: yew src/search/parse.lu:12-23 at 83020234 (explicit
//! group stack / indexed AST), ferp src/regex/regex_parser.f90:1-21 at
//! 7d332b5 (precedence and node pool). Neither dialect is copied.

const EMPTY_NODE: int = 20

const CAT_NODE: int = 21

const ALT_NODE: int = 22

const REPEAT_NODE: int = 23

const GROUP_NODE: int = 24

struct Node {
    op: int,
    a: int,
    b: int,
    arg: int,
    lower: int,
    upper: int,
}

struct Frame {
    cat: int,
    alt: int,
    group: int,
    available: int,
    completed: int,
    initial: int,
    beginning: bool,
    repeatable: bool,
    interval_operand: bool,
}

struct Parser {
    at: int,
    group: int,
    nodes: List[Node],
    classes: List[bool],
    frames: List[Frame],
    has_ref: bool,
    verify: bool,
    discarded_repeat: bool,
    failed: bool,
}

fn node(mut p: Parser, op: int, a: int, b: int, arg: int, lower: int, upper: int) -> int {
    (mut p.nodes).push(Node { op: op, a: a, b: b, arg: arg, lower: lower, upper: upper })
    p.nodes.len - 1
}

fn join(mut p: Parser, op: int, left: int, right: int) -> int {
    if left < 0 { return right }
    if right < 0 { return left }
    node(mut p, op, left, right, 0, 0, 0)
}

fn append_atom(mut p: Parser, atom: int) {
    let last = p.frames.len - 1
    let prior = p.frames[last].cat
    p.frames[last].cat = join(mut p, CAT_NODE, prior, atom)
    p.frames[last].beginning = false
    if p.nodes[atom].op < BOL || p.nodes[atom].op > WORD_END {
        p.frames[last].repeatable = true
        if p.nodes[atom].op != CHAR || p.nodes[atom].arg != 123 {
            p.frames[last].interval_operand = true
        }
    }
}

fn fail(mut p: Parser, mut d: Diagnostics, pattern: int, text: str) {
    if !p.failed {
        message(mut d, pattern, false, text)
        p.failed = true
    }
}

fn class_member(name: str, c: int) -> bool {
    let alpha = c >= 65 && c <= 90 || c >= 97 && c <= 122
    let digit = c >= 48 && c <= 57
    if name == "alnum" { return alpha || digit }
    if name == "alpha" { return alpha }
    if name == "blank" { return c == 9 || c == 32 }
    if name == "cntrl" { return c < 32 || c == 127 }
    if name == "digit" { return digit }
    if name == "graph" { return c >= 33 && c <= 126 }
    if name == "lower" { return c >= 97 && c <= 122 }
    if name == "print" { return c >= 32 && c <= 126 }
    if name == "punct" { return c >= 33 && c <= 126 && !alpha && !digit }
    if name == "space" { return is_space(c) }
    if name == "upper" { return c >= 65 && c <= 90 }
    if name == "xdigit" { return digit || c >= 65 && c <= 70 || c >= 97 && c <= 102 }
    false
}

fn class_known(name: str) -> bool {
    name == "alnum" ||
        name == "alpha" ||
        name == "blank" ||
        name == "cntrl" ||
        name == "digit" ||
        name == "graph" ||
        name == "lower" ||
        name == "print" ||
        name == "punct" ||
        name == "space" ||
        name == "upper" ||
        name == "xdigit"
}

fn class_new(mut p: Parser) -> int {
    let id = p.classes.len / 256
    var b = 0
    while b < 256 { (mut p.classes).push(false); b += 1 }
    id
}

fn class_finish(mut p: Parser, id: int, negate: bool, icase: bool) {
    let base = id * 256
    if icase {
        var b = 65
        while b <= 90 {
            let present = p.classes[base + b] || p.classes[base + b + 32]
            p.classes[base + b] = present
            p.classes[base + b + 32] = present
            b += 1
        }
    }
    if negate {
        var b = 0
        while b < 256 { p.classes[base + b] = !p.classes[base + b]; b += 1 }
    }
}

fn bracket_item(mut p: Parser, pat: List[byte], id: int, mut d: Diagnostics, pattern: int) -> int {
    let c = pat[p.at] as int
    if c == 91 &&
        p.at + 1 < pat.len &&
        (
            pat[p.at + 1] == 58 as byte ||
                pat[p.at + 1] == 46 as byte ||
                pat[p.at + 1] == 61 as byte
        ) {
        let mark = pat[p.at + 1]
        let begin = p.at + 2
        var end = begin
        while end + 1 < pat.len && !(pat[end] == mark && pat[end + 1] == 93 as byte) { end += 1 }
        if end + 1 >= pat.len {
            fail(mut p, mut d, pattern, "Unmatched [, [^, [:, [., or [=")
            return -1
        }
        p.at = end + 2
        if mark == 58 as byte {
            var bytes = List[byte]()
            var j = begin
            while j < end { (mut bytes).push(pat[j]); j += 1 }
            let name = str_from_utf8(bytes) else ""
            if !class_known(name) {
                fail(mut p, mut d, pattern, "Invalid character class name")
                return -1
            }
            var b = 0
            while b < 256 {
                if class_member(name, b) { p.classes[id * 256 + b] = true }
                b += 1
            }
            return -1
        }
        p.verify = true
        if end != begin + 1 {
            fail(mut p, mut d, pattern, "Invalid collation character")
            return -1
        }
        return pat[begin] as int
    }
    p.at += 1
    c
}

fn bracket(
    mut p: Parser,
    pat: List[byte],
    options: Options,
    mut d: Diagnostics,
    pattern: int,
) -> int {
    // GNU diagnoses any outer [:...:] form, including unknown names;
    // the diagnostic deliberately uses space as its example (probe [:e:]).
    var closing = p.at + 2
    if p.at + 1 < pat.len && pat[p.at + 1] == 58 as byte {
        while closing < pat.len && pat[closing] != 93 as byte { closing += 1 }
        if closing < pat.len && closing > p.at + 3 && pat[closing - 1] == 58 as byte {
            fail(mut p, mut d, pattern, "character class syntax is [[:space:]], not [:space:]")
            return 0
        }
    }
    p.at += 1
    var negate = false
    if p.at < pat.len && pat[p.at] == 94 as byte { negate = true; p.at += 1 }
    if p.at == pat.len {
        fail(mut p, mut d, pattern, "Invalid regular expression")
        return 0
    }
    let id = class_new(mut p)
    var first = true
    while p.at < pat.len && !p.failed {
        if pat[p.at] == 93 as byte && !first {
            p.at += 1
            class_finish(mut p, id, negate, options.icase)
            return node(mut p, CLASS, -1, -1, id, 0, 0)
        }
        first = false
        let left = bracket_item(mut p, pat, id, mut d, pattern)
        if p.failed { break }
        if p.at + 1 < pat.len && pat[p.at] == 45 as byte && pat[p.at + 1] != 93 as byte {
            p.at += 1
            let right = bracket_item(mut p, pat, id, mut d, pattern)
            if p.failed { break }
            if left < 0 || right < left {
                fail(mut p, mut d, pattern, "Invalid range end")
                break
            }
            var b = left
            while b <= right { p.classes[id * 256 + b] = true; b += 1 }
            if p.at + 1 < pat.len && pat[p.at] == 45 as byte && pat[p.at + 1] != 93 as byte {
                fail(mut p, mut d, pattern, "Invalid range end")
            }
        } else if left >= 0 {
            p.classes[id * 256 + left] = true
        }
    }
    fail(mut p, mut d, pattern, "Unmatched [, [^, [:, [., or [=")
    0
}

fn symbol(pat: List[byte], at: int, code: int, extended: bool) -> bool {
    if at >= pat.len { return false }
    if extended { return pat[at] as int == code }
    at + 1 < pat.len && pat[at] == 92 as byte && pat[at + 1] as int == code
}

fn finish_branch(mut p: Parser) {
    let k = p.frames.len - 1
    var cat = p.frames[k].cat
    if cat < 0 { cat = node(mut p, EMPTY_NODE, -1, -1, 0, 0, 0) }
    let prev = p.frames[k].alt
    p.frames[k].completed |= p.frames[k].available
    p.frames[k].alt = join(mut p, ALT_NODE, prev, cat)
    p.frames[k].cat = -1
    p.frames[k].beginning = true
    p.frames[k].repeatable = false
    p.frames[k].interval_operand = false
    p.discarded_repeat = false
}

fn interval(mut p: Parser, pat: List[byte], options: Options, mut d: Diagnostics, pattern: int) -> (
    bool,
    int,
    int,
) {
    let width = if options.extended then 1 else 2
    let begin = p.at
    var at = begin + width
    var lower = 0
    var upper = 0
    var comma = false
    var digits = false
    var too_big = false
    while at < pat.len && pat[at] >= 48 as byte && pat[at] <= 57 as byte {
        digits = true
        lower = if lower > 32767 then 32768 else lower * 10 + pat[at] as int - 48
        at += 1
    }
    if at < pat.len && pat[at] == 44 as byte {
        comma = true
        at += 1
        let before = at
        while at < pat.len && pat[at] >= 48 as byte && pat[at] <= 57 as byte {
            upper = if upper > 32767 then 32768 else upper * 10 + pat[at] as int - 48
            at += 1
        }
        if at == before { upper = -1 }
    } else {
        upper = lower
    }
    too_big = lower > 32767 || upper > 32767
    if !symbol(pat, at, 125, options.extended) {
        if options.extended {
            // A closing brace with malformed numeric content is an error;
            // an incomplete interval or an alphabetic beginning is literal.
            var end = at
            while end < pat.len && pat[end] != 125 as byte { end += 1 }
            if end < pat.len && (digits || comma || at == begin + width && end == at) {
                fail(mut p, mut d, pattern, "Invalid content of \\{{\\}}")
            }
            return (false, 0, 0)
        }
        var end = at
        while end < pat.len && !symbol(pat, end, 125, false) { end += 1 }
        fail(
            mut p,
            mut d,
            pattern,
            if end == pat.len then "Unmatched \\{{" else "Invalid content of \\{{\\}}",
        )
        return (false, 0, 0)
    }
    let leading = options.extended && !p.frames[p.frames.len - 1].interval_operand
    if !digits && !comma || upper >= 0 && lower > upper {
        if leading { return (false, 0, 0) }
        fail(mut p, mut d, pattern, "Invalid content of \\{{\\}}")
    }
    p.at = at + width
    if too_big {
        if leading {
            if !p.frames[p.frames.len - 1].repeatable {
                message(mut d, pattern, true, "warning: {{...}} at start of expression")
            }
            fail(mut p, mut d, pattern, "regular expression too big")
            return (false, 0, 0)
        }
        fail(mut p, mut d, pattern, "Regular expression too big")
    }
    (true, lower, upper)
}

fn parse_mode(
    pat: List[byte],
    options: Options,
    mut d: Diagnostics,
    pattern: int,
    spans: bool,
) -> Parser {
    var p = Parser {
        at: 0,
        group: 0,
        nodes: List[Node](),
        classes: List[bool](),
        frames: List[Frame](),
        has_ref: false,
        verify: false,
        discarded_repeat: false,
        failed: false,
    }
    (mut p.frames).push(Frame {
        cat: -1,
        alt: -1,
        group: 0,
        available: 0,
        completed: 0,
        initial: 0,
        beginning: true,
        repeatable: false,
        interval_operand: false,
    })
    let width = if options.extended then 1 else 2
    while p.at < pat.len && !p.failed {
        let at = p.at
        let c = pat[at] as int
        let k = p.frames.len - 1
        if symbol(pat, at, 40, options.extended) {
            p.discarded_repeat = false
            p.at += width
            p.group += 1
            let available = p.frames[k].available
            (mut p.frames).push(Frame {
                cat: -1,
                alt: -1,
                group: p.group,
                available: available,
                completed: 0,
                initial: available,
                beginning: true,
                repeatable: false,
                interval_operand: false,
            })
            continue
        }
        if symbol(pat, at, 41, options.extended) && (k > 0 || !options.extended) {
            if spans && p.discarded_repeat && k > 0 {
                fail(mut p, mut d, pattern, "Unmatched ( or \\(")
                break
            }
            if k == 0 { fail(mut p, mut d, pattern, "Unmatched ) or \\)"); break }
            p.at += width
            finish_branch(mut p)
            let frame = (mut p.frames).pop() else Frame {
                cat: -1,
                alt: -1,
                group: 0,
                available: 0,
                completed: 0,
                initial: 0,
                beginning: false,
                repeatable: false,
                interval_operand: false,
            }
            let n = node(mut p, GROUP_NODE, frame.alt, -1, frame.group, 0, 0)
            append_atom(mut p, n)
            if frame.group <= 9 { p.frames[k - 1].available |= 1 << frame.group }
            p.frames[k - 1].available |= frame.completed
            continue
        }
        if symbol(pat, at, 124, options.extended) {
            p.at += width
            finish_branch(mut p)
            p.frames[k].available = p.frames[k].initial
            continue
        }
        var quant = 0
        if c == 42 { quant = 42 }
        if symbol(pat, at, 43, options.extended) { quant = 43 }
        if symbol(pat, at, 63, options.extended) { quant = 63 }
        if symbol(pat, at, 123, options.extended) { quant = 123 }
        let beginning = p.frames[k].beginning
        let repeatable = p.frames[k].repeatable
        let cat = p.frames[k].cat
        let last = if cat < 0 {
            -1
        } else {
            (if p.nodes[cat].op == CAT_NODE then p.nodes[cat].b else cat)
        }
        let after_assertion = last >= 0 && p.nodes[last].op >= BOL && p.nodes[last].op <= WORD_END
        if spans && (after_assertion || last < 0) && options.extended && quant > 0 {
            // Span parsing discards a leading operator byte, even an
            // incomplete brace, but then requires an atom before group-close.
            p.at = at + 1
            p.discarded_repeat = true
            continue
        }
        if quant > 0 && (options.extended || repeatable) && !(spans && after_assertion) {
            var lower = if quant == 43 then 1 else 0
            var upper = if quant == 63 then 1 else -1
            var valid = true
            if quant == 123 {
                let (yes, low, high) = interval(mut p, pat, options, mut d, pattern)
                valid = yes
                lower = low
                upper = high
            } else {
                p.at += if quant == 42 then 1 else width
            }
            if valid {
                if !repeatable && options.extended {
                    let name = if quant == 42 {
                        "*"
                    } else {
                        (if quant == 43 then "+" else (if quant == 63 then "?" else "{{...}}"))
                    }
                    message(mut d, pattern, true, "warning: {name} at start of expression")
                }
                if last >= 0 {
                    let repeated = node(mut p, REPEAT_NODE, last, -1, 0, lower, upper)
                    if p.nodes[cat].op == CAT_NODE {
                        p.nodes[cat].b = repeated
                    } else {
                        p.frames[k].cat = repeated
                    }
                }
                if quant == 123 {
                    p.frames[k].repeatable = true
                    p.frames[k].interval_operand = true
                }
                continue
            }
        }
        var atom = -1
        if c == 91 {
            atom = bracket(mut p, pat, options, mut d, pattern)
        } else if c == 46 {
            p.at += 1
            atom = node(mut p, ANY, -1, -1, 0, 0, 0)
        } else if c == 94 && (options.extended || beginning) {
            p.at += 1
            atom = node(mut p, BOL, -1, -1, 0, 0, 0)
        } else if c == 36 &&
            (
                options.extended ||
                    at + 1 == pat.len ||
                    !spans &&
                        at + 1 < pat.len &&
                        (pat[at + 1] == 41 as byte || pat[at + 1] == 124 as byte) ||
                    symbol(pat, at + 1, 41, false) ||
                    symbol(pat, at + 1, 124, false)
            ) {
            p.at += 1
            atom = node(mut p, EOL, -1, -1, 0, 0, 0)
        } else if c == 92 {
            p.at += 1
            if p.at == pat.len { fail(mut p, mut d, pattern, "Trailing backslash"); break }
            let escaped = pat[p.at] as int
            p.at += 1
            if escaped >= 49 && escaped <= 57 {
                let g = escaped - 48
                if p.frames[k].available & 1 << g == 0 {
                    fail(mut p, mut d, pattern, "Invalid back reference")
                    break
                }
                p.has_ref = true
                atom = node(mut p, REF, -1, -1, g, 0, 0)
            } else if escaped == 119 || escaped == 87 || escaped == 115 || escaped == 83 {
                let id = class_new(mut p)
                var b = 0
                while b < 256 {
                    p.classes[id * 256 + b] = if escaped == 119 || escaped == 87 {
                        is_word(b)
                    } else {
                        is_space(b)
                    }
                    b += 1
                }
                class_finish(mut p, id, escaped == 87 || escaped == 83, options.icase)
                atom = node(mut p, CLASS, -1, -1, id, 0, 0)
            } else {
                var op = CHAR
                if escaped == 98 { op = BOUND }
                if escaped == 66 { op = NOT_BOUND }
                if escaped == 60 { op = WORD_START }
                if escaped == 62 { op = WORD_END }
                if escaped == 96 { op = BOL }
                if escaped == 39 { op = EOL }
                atom = node(mut p, op, -1, -1, escaped, 0, 0)
                if op == CHAR &&
                    !(
                        escaped == 92 ||
                            escaped == 46 ||
                            escaped == 91 ||
                            escaped == 93 ||
                            escaped == 94 ||
                            escaped == 36 ||
                            escaped == 42 ||
                            escaped == 125 ||
                            options.extended &&
                                (
                                    escaped == 40 ||
                                        escaped == 41 ||
                                        escaped == 123 ||
                                        escaped == 124 ||
                                        escaped == 43 ||
                                        escaped == 63
                                )
                    ) {
                    if escaped < 32 || escaped > 126 {
                        message(
                            mut d,
                            pattern,
                            true,
                            "warning: stray \\ before unprintable character",
                        )
                    } else if escaped == 32 {
                        message(mut d, pattern, true, "warning: stray \\ before white space")
                    } else {
                        var text = "warning: stray \\ before ".bytes()
                        (mut text).push(escaped as byte)
                        (mut d.items).push(Diagnostic {
                            pattern: pattern,
                            warning: true,
                            text: text,
                        })
                    }
                }
            }
        } else {
            p.at += 1
            atom = node(mut p, CHAR, -1, -1, c, 0, 0)
        }
        if !p.failed {
            p.discarded_repeat = false
            append_atom(mut p, atom)
            if c == 92 && p.nodes[atom].op == CHAR { p.frames[k].interval_operand = true }
        }
    }
    if !p.failed && p.frames.len > 1 { fail(mut p, mut d, pattern, "Unmatched ( or \\(") }
    if !p.failed { finish_branch(mut p) }
    p
}

fn parse(pat: List[byte], options: Options, mut d: Diagnostics, pattern: int) -> Parser {
    parse_mode(pat, options, mut d, pattern, false)
}
