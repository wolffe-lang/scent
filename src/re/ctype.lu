//! Measured tables, not libc calls. Packed scalar ranges and consistent
//! case edges generated by tools/gen-ctype-tables from UCD + overrides.

fn packed(s: str, at: int, width: int) -> int {
    var value = 0
    var i = 0
    while i < width { value = value * 128 + s.bytes()[at + i] as int; i += 1 }
    value
}

/// POSIX class bits alpha/alnum/digit/upper/lower/space/blank/punct/
/// cntrl/graph/print/xdigit/word, measured over every Unicode scalar.
pub fn character_mask(cp: int) -> int {
    if cp < 0 || cp > 1114111 { return 0 }
    var lo = 0
    var hi = CTYPE_COUNT
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        let base = mid * 8
        if cp < packed(CTYPE_DATA, base, 3) {
            hi = mid
        } else if cp > packed(CTYPE_DATA, base + 3, 3) {
            lo = mid + 1
        } else {
            return packed(CTYPE_DATA, base + 6, 2)
        }
    }
    0
}

/// First directed pair whose source is at least cp.
fn fold_start(cp: int) -> int {
    var lo = 0
    var hi = FOLD_COUNT
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if packed(FOLD_DATA, mid * 6, 3) < cp { lo = mid + 1 } else { hi = mid }
    }
    lo
}

/// Consistent symmetric/transitive closure of measured case edges (#122).
pub fn case_matches(pattern: int, text: int) -> bool {
    if pattern == text { return true }
    if pattern > 1114111 || text > 1114111 { return false }
    var at = fold_start(pattern)
    while at < FOLD_COUNT && packed(FOLD_DATA, at * 6, 3) == pattern {
        if packed(FOLD_DATA, at * 6 + 3, 3) == text { return true }
        at += 1
    }
    false
}

fn property_bit(name: str) -> int {
    if name == "alpha" { return 1 }
    if name == "alnum" { return 2 }
    if name == "digit" { return 4 }
    if name == "upper" { return 8 }
    if name == "lower" { return 16 }
    if name == "space" { return 32 }
    if name == "blank" { return 64 }
    if name == "punct" { return 128 }
    if name == "cntrl" { return 256 }
    if name == "graph" { return 512 }
    if name == "print" { return 1024 }
    if name == "xdigit" { return 2048 }
    if name == "word" { return 4096 }
    0
}

struct RuneClass {
    members: List[int],
    properties: int,
    negate: bool,
}

fn rune_class_member(cl: RuneClass, cp: int, icase: bool) -> bool {
    if cp >= 2147483648 { return false }
    var bits = cl.properties
    if icase && bits & 24 != 0 { bits |= 1 }
    var found = character_mask(cp) & bits != 0
    for member in cl.members {
        if member == cp || icase && case_matches(member, cp) { found = true; break }
    }
    if cl.negate then !found else found
}
