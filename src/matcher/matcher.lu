//! member: true

// Clean-room dispatch: POSIX grep and the pinned GNU binary; docs/RE.md.
use fixed
use re

/// Immutable compiled literal and regex pools; only the selected one has patterns.
pub struct Matcher {
    syntax: str,
    literal: fixed.Matcher,
    regular: re.Regex,
}

/// Reusable execution storage, allocated outside the line loop.
pub struct Workspace {
    literal: fixed.Workspace,
    regular: re.Workspace,
}

/// Half-open original-buffer byte offsets.
pub struct Span {
    lo: int,
    hi: int,
}

/// Compile the selected syntax and retain ordered compiler diagnostics.
pub fn compile(
    patterns: List[List[byte]],
    syntax: str,
    flags: fixed.Flags,
    mut diagnostics: re.Diagnostics,
) -> Matcher ! {invalid} {
    let empty = List[List[byte]]()
    let literal = fixed.compile(if syntax == "F" then copy patterns else copy empty, flags)
    let regular = re.compile(
        if syntax == "F" then empty else patterns,
        re.Options {
            extended: syntax == "E",
            icase: flags.ignore_case,
            word: flags.word,
            whole: flags.whole,
            terminator: flags.terminator,
        },
        mut diagnostics,
    )?
    Matcher { syntax: syntax, literal: literal, regular: regular }
}

/// Allocate both execution workspaces once per chunk.
pub fn workspace_new(compiled: Matcher) -> Workspace {
    Workspace {
        literal: fixed.workspace_new(compiled.literal),
        regular: re.workspace_new(compiled.regular),
    }
}

/// Select a line, including empty matches, before requesting its spans.
pub fn line_matches(
    compiled: Matcher,
    mut ws: Workspace,
    buf: List[byte],
    lo: int,
    hi: int,
) -> bool {
    if compiled.syntax == "F" {
        return fixed.line_matches(compiled.literal, mut ws.literal, buf, lo, hi)
    }
    re.line_matches(compiled.regular, mut ws.regular, buf, lo, hi)
}

/// Nonempty leftmost-longest span on the previously selected unchanged line.
pub fn next_span(
    compiled: Matcher,
    mut ws: Workspace,
    buf: List[byte],
    lo: int,
    hi: int,
    from: int,
) -> Span ! {none} {
    if compiled.syntax == "F" {
        let s = fixed.next_span(compiled.literal, mut ws.literal, buf, lo, hi, from)?
        return Span { lo: s.lo, hi: s.hi }
    }
    let s = re.next_span(compiled.regular, mut ws.regular, buf, lo, hi, from)?
    Span { lo: s.lo, hi: s.hi }
}
